{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool-shelf",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tools.yhay81.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["31 18 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tool-shelf",
      "database_id": "b2cdfc6e-7c54-46e4-b6b5-129b1ee590c5",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
